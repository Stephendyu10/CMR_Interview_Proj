import { and, eq } from "drizzle-orm";

import { db } from "../index";
import { requests } from "../schema";

export async function createRequest(
  firmId: string,
  clientId: string,
  engagementId: string,
  title: string,
  description?: string,
  assignedToUserId?: string,
  dueDate?: string,
) {
  const [request] = await db
    .insert(requests)
    .values({
      firmId,
      clientId,
      engagementId,
      title,
      description,
      assignedToUserId,
      dueDate,
    })
    .returning();

  return request;
}

export async function getRequestsByEngagement(
  engagementId: string,
  firmId: string,
) {
  return db
    .select()
    .from(requests)
    .where(
      and(
        eq(requests.engagementId, engagementId),
        eq(requests.firmId, firmId),
      ),
    );
}

export async function getRequestByIdForFirm(
  requestId: string,
  firmId: string,
) {
  const [request] = await db
    .select()
    .from(requests)
    .where(
      and(
        eq(requests.id, requestId),
        eq(requests.firmId, firmId),
      ),
    )
    .limit(1);

  return request;
}

export async function updateRequestForFirm(
  requestId: string,
  firmId: string,
  data: {
    title?: string;
    description?: string | null;
    status?: string;
    assignedToUserId?: string | null;
    dueDate?: string | null;
    sentAt?: Date | null;
    completedAt?: Date | null;
  },
) {
  const [request] = await db
    .update(requests)
    .set({
      ...data,
      updatedAt: new Date(),
    })
    .where(
      and(
        eq(requests.id, requestId),
        eq(requests.firmId, firmId),
      ),
    )
    .returning();

  return request;
}

export async function deleteRequestForFirm(
  requestId: string,
  firmId: string,
) {
  const [request] = await db
    .delete(requests)
    .where(
      and(
        eq(requests.id, requestId),
        eq(requests.firmId, firmId),
      ),
    )
    .returning();

  return request;
}
